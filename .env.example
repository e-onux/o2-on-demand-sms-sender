# Modem login credentials
API_USER=your_username_here
API_PASSWORD=your_password_here

# Modem IP (Huawei devices are often 192.168.8.1)
MODEM_HOST=192.168.8.1

# Periodic run interval (seconds)
INTERVAL_SECONDS=60

# Keep the newest N incoming/sent modem SMS messages combined
SMS_RETENTION_COUNT=3

# Send a new WEITER SMS after this many additional GiB have been used
SMS_THRESHOLD_GB=1.9

# Timezone
TZ=Europe/Berlin

# Slow-connection recovery: SMS once, then modem restarts with growing gaps
WATCHDOG_ENABLED=true
# A download probe below this speed counts as slow (Mbit/s)
WATCHDOG_MIN_DOWNLOAD_MBPS=5
# Minutes to wait after each automatic restart before the next one is allowed
WATCHDOG_RESTART_BACKOFF_MINUTES=30,180,360,720,1440
WATCHDOG_MAX_RESTARTS_PER_DAY=4
