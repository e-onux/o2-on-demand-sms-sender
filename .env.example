# Modem login credentials
API_USER=your_username_here
API_PASSWORD=your_password_here

# Modem IP (Huawei devices are often 192.168.8.1)
MODEM_HOST=192.168.8.1

# Periodic run interval (seconds)
INTERVAL_SECONDS=60

# Keep the newest N incoming/sent modem SMS messages combined
SMS_RETENTION_COUNT=3

# Send a new WEITER SMS after this many additional GiB have been used
SMS_THRESHOLD_GB=1.9

# Timezone
TZ=Europe/Berlin
